# Copy this file to .env and fill in your own key. Never commit the real .env file.
#
# Google Cloud Vision API key used for chord chart OCR (chord-scan feature).
# Create one at https://console.cloud.google.com/apis/credentials after enabling
# the Cloud Vision API for your project. EXPO_PUBLIC_ vars are inlined into the
# app bundle at build time, so this key will be visible to anyone with the app
# binary — restrict it to the Vision API in the Google Cloud console.
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=
